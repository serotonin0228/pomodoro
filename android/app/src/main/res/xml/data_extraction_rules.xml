<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="pomodoro.workspace.v1.xml" />
        <exclude domain="sharedpref" path="timer_mode_drafts.xml" />
        <exclude domain="sharedpref" path="music.xml" />
        <exclude domain="sharedpref" path="music_catalogue.xml" />
        <exclude domain="sharedpref" path="music_playback.xml" />
        <exclude domain="sharedpref" path="focus-guard.xml" />
        <exclude domain="file" path="music/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="pomodoro.workspace.v1.xml" />
        <exclude domain="sharedpref" path="timer_mode_drafts.xml" />
        <exclude domain="sharedpref" path="music.xml" />
        <exclude domain="sharedpref" path="music_catalogue.xml" />
        <exclude domain="sharedpref" path="music_playback.xml" />
        <exclude domain="sharedpref" path="focus-guard.xml" />
        <exclude domain="file" path="music/" />
    </device-transfer>
</data-extraction-rules>
