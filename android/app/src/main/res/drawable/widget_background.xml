<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="@color/widget_glass_start"
                android:endColor="@color/widget_glass_end" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.08"
                android:gradientRadius="144dp"
                android:startColor="@color/widget_glass_highlight"
                android:centerColor="@color/widget_glass_highlight_fade"
                android:endColor="@android:color/transparent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="1.0"
                android:gradientRadius="140dp"
                android:startColor="@color/widget_glass_cool"
                android:centerColor="@color/widget_glass_cool_fade"
                android:endColor="@android:color/transparent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_edge" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
